# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gostudy_database
DB_USERNAME=gostudy_user
DB_PASSWORD=change_me

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=mail@example.com
MAIL_PASSWORD=change_me
MAIL_FROM_ADDRESS=mail@example.com
MAIL_FROM_NAME=GoStudy

# Uploads
# Absolute server paths. The private directory must be outside the public site root.
UPLOAD_PUBLIC_DIR=/absolute/path/to/gostudyonline.ru/uploads
UPLOAD_PUBLIC_URL=https://example.com/uploads
UPLOAD_PRIVATE_DIR=/absolute/path/outside/public/root/gostudy-private
UPLOAD_PHOTO_MAX_BYTES=5242880
UPLOAD_DOCUMENT_MAX_BYTES=10485760
UPLOAD_VIDEO_MAX_BYTES=104857600
UPLOAD_HOMEWORK_MAX_BYTES=10485760
UPLOAD_HOMEWORK_TOTAL_MAX_BYTES=31457280
UPLOAD_CLASSROOM_MAX_BYTES=10485760
UPLOAD_CLASSROOM_TOTAL_MAX_BYTES=31457280
UPLOAD_CLASSROOM_LESSON_MAX_BYTES=104857600

# Server cron calls /api/cron/homework.php with this token.
CRON_TOKEN=replace_with_a_long_random_secret
