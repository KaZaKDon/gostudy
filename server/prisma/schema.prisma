generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
  PARENT
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  ARCHIVED
  DELETED
}

enum LegalAcceptanceType {
  PLATFORM_DOCUMENTS
  PERSONAL_DATA
  MARKETING
  PARENT_CHILD_DATA
}

enum LegalAcceptanceSource {
  REGISTRATION
  PROFILE
  RECONSENT
  ADMIN
}

enum TeacherVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum LessonStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum LessonSessionStatus {
  WAITING
  ACTIVE
  ENDED
}

enum HomeworkStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum HomeworkSubmissionStatus {
  SUBMITTED
  RETURNED
  ACCEPTED
}

enum LessonChangeType {
  RESCHEDULE
  CANCEL
}

enum LessonChangeStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum TeacherStudentStatus {
  ACTIVE
  ARCHIVED
}

enum TeacherStudentRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewReplyStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum MaterialOwnerType {
  PLATFORM
  TEACHER
}

enum MaterialCategory {
  TEXTBOOK
  TRAINER
  EXTRA
}

enum MaterialContentType {
  FILE
  EXTERNAL_LINK
  INTERACTIVE_LINK
}

enum MaterialAccessType {
  FREE
  PAID
}

enum MaterialPublicationStatus {
  PRIVATE
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum MaterialAccessSource {
  ASSIGNMENT
  PURCHASE
  MANUAL
}

enum MaterialReportReason {
  COPYRIGHT
  INAPPROPRIATE
  HARMFUL
  BROKEN_LINK
  OTHER
}

enum MaterialReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ParentStudentStatus {
  ACTIVE
  ARCHIVED
}

enum MessageChannelType {
  STUDENT
  PARENT
}

enum MessageSenderContext {
  TEACHER
  STUDENT
  PARENT
}

enum MessageReportReason {
  SPAM
  ABUSE
  INAPPROPRIATE
  THREAT
  OTHER
}

enum MessageReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model User {
  id                          Int                         @id @default(autoincrement())
  role                        UserRole
  email                       String                      @unique @db.VarChar(320)
  passwordHash                String                      @map("password_hash") @db.VarChar(255)
  fullName                    String?                     @map("full_name") @db.VarChar(255)
  phone                       String?                     @db.VarChar(40)
  avatarUrl                   String?                     @map("avatar_url") @db.Text
  status                      UserStatus                  @default(ACTIVE)
  blockedReason               String?                     @map("blocked_reason") @db.VarChar(1000)
  archivedAt                  DateTime?                   @map("archived_at") @db.Timestamptz(3)
  archivedById                Int?                        @map("archived_by")
  archiveReason               String?                     @map("archive_reason") @db.VarChar(1000)
  emailVerifiedAt             DateTime?                   @map("email_verified_at")
  emailVerificationTokenHash  String?                     @unique @map("email_verification_token_hash") @db.Char(64)
  emailVerificationExpiresAt  DateTime?                   @map("email_verification_expires_at")
  emailVerificationSentAt     DateTime?                   @map("email_verification_sent_at")
  profileCompleted            Boolean                     @default(false) @map("profile_completed")
  lastLoginAt                 DateTime?                   @map("last_login_at")
  createdAt                   DateTime                    @default(now()) @map("created_at")
  updatedAt                   DateTime                    @updatedAt @map("updated_at")
  studentProfile              StudentProfile?
  teacherProfile              TeacherProfile?
  sessions                    AuthSession[]
  passwordResetTokens         PasswordResetToken[]
  legalAcceptances            LegalAcceptance[]
  teacherSubjects             TeacherSubject[]            @relation("TeacherSubjects")
  teacherSubjectPreparations  TeacherSubjectPreparation[] @relation("TeacherSubjectPreparations")
  teacherAgeGroups            TeacherAgeGroup[]           @relation("TeacherAgeGroups")
  teacherEducation            TeacherEducation[]          @relation("TeacherEducation")
  lessonsAsTeacher            Lesson[]                    @relation("LessonTeacher")
  lessonsAsStudent            Lesson[]                    @relation("LessonStudent")
  lessonSessionsStarted       LessonSession[]             @relation("LessonSessionStarter")
  lessonSessionsEnded         LessonSession[]             @relation("LessonSessionEnder")
  lessonMessages              LessonMessage[]
  lessonFiles                 LessonFile[]                @relation("LessonFileUploader")
  lessonWorkspaceUpdates      LessonWorkspaceState[]      @relation("LessonWorkspaceUpdater")
  homeworkAssigned            Homework[]                  @relation("HomeworkTeacher")
  homeworkReceived            Homework[]                  @relation("HomeworkStudent")
  homeworkSubmissions         HomeworkSubmission[]
  lessonChangesRequested      LessonChangeRequest[]       @relation("LessonChangeRequester")
  lessonChangesResponded      LessonChangeRequest[]       @relation("LessonChangeResponder")
  teachingRelations           TeacherStudent[]            @relation("TeacherStudentTeacher")
  learningRelations           TeacherStudent[]            @relation("TeacherStudentStudent")
  teachingRequests            TeacherStudentRequest[]     @relation("TeacherRequestTeacher")
  learningRequests            TeacherStudentRequest[]     @relation("TeacherRequestStudent")
  notifications               Notification[]
  archivedBy                  User?                       @relation("UserArchiveActor", fields: [archivedById], references: [id], onDelete: SetNull)
  archivedUsers               User[]                      @relation("UserArchiveActor")
  adminAuditLogs              AdminAuditLog[]             @relation("AdminAuditActor")
  verifiedTeacherProfiles     TeacherProfile[]            @relation("TeacherProfileVerifier")
  reviewsAsStudent            Review[]                    @relation("ReviewStudent")
  reviewsAsTeacher            Review[]                    @relation("ReviewTeacher")
  reviewsModerated            Review[]                    @relation("ReviewModerator")
  repliesModerated            Review[]                    @relation("ReviewReplyModerator")
  materialsCreated            LearningMaterial[]          @relation("MaterialCreator")
  materialsModerated          LearningMaterial[]          @relation("MaterialModerator")
  materialAssignmentsGiven    MaterialAssignment[]        @relation("MaterialAssignmentTeacher")
  materialAssignmentsReceived MaterialAssignment[]        @relation("MaterialAssignmentStudent")
  materialAccessGrants        MaterialAccessGrant[]       @relation("MaterialGrantRecipient")
  materialAccessGranted       MaterialAccessGrant[]       @relation("MaterialGrantActor")
  materialReports             MaterialReport[]            @relation("MaterialReporter")
  materialReportsHandled      MaterialReport[]            @relation("MaterialReportHandler")
  parentLinks                 ParentStudent[]             @relation("ParentStudentParent")
  childLinks                  ParentStudent[]             @relation("ParentStudentChild")
  messageDialogsAsTeacher     MessageDialog[]             @relation("MessageDialogTeacher")
  messageDialogsAsStudent     MessageDialog[]             @relation("MessageDialogStudent")
  messageDialogsAsParent      MessageDialog[]             @relation("MessageDialogParent")
  messagesSent                Message[]
  messagesHidden              Message[]                   @relation("MessageHiddenBy")
  messageReports              MessageReport[]             @relation("MessageReporter")
  messageReportsHandled       MessageReport[]             @relation("MessageReportHandler")

  @@index([role, status])
  @@index([archivedById])
  @@map("users")
}

model AdminAuditLog {
  id         BigInt   @id @default(autoincrement())
  adminId    Int      @map("admin_id")
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   Int?     @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  admin      User     @relation("AdminAuditActor", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("admin_audit_logs")
}

model Notification {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  type             String    @db.VarChar(64)
  dedupeKey        String?   @map("dedupe_key") @db.VarChar(190)
  title            String    @db.VarChar(160)
  message          String    @db.VarChar(500)
  targetSection    String?   @map("target_section") @db.VarChar(64)
  targetEntityType String?   @map("target_entity_type") @db.VarChar(64)
  targetEntityId   Int?      @map("target_entity_id")
  targetDate       String?   @map("target_date") @db.VarChar(10)
  isRead           Boolean   @default(false) @map("is_read")
  readAt           DateTime? @map("read_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, id])
  @@index([userId, isRead])
  @@map("notifications")
}

model ParentStudent {
  id         Int                 @id @default(autoincrement())
  parentId   Int                 @map("parent_id")
  studentId  Int                 @map("student_id")
  status     ParentStudentStatus @default(ACTIVE)
  verifiedAt DateTime?           @map("verified_at") @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent     User                @relation("ParentStudentParent", fields: [parentId], references: [id], onDelete: Restrict)
  student    User                @relation("ParentStudentChild", fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([parentId, studentId])
  @@index([studentId, status])
  @@map("parent_students")
}

model MessageDialog {
  id            Int                @id @default(autoincrement())
  teacherId     Int                @map("teacher_id")
  studentId     Int                @map("student_id")
  parentId      Int?               @map("parent_id")
  channelType   MessageChannelType @map("channel_type")
  channelKey    String             @map("channel_key") @db.VarChar(80)
  lastMessageAt DateTime?          @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  teacher       User               @relation("MessageDialogTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  student       User               @relation("MessageDialogStudent", fields: [studentId], references: [id], onDelete: Restrict)
  parent        User?              @relation("MessageDialogParent", fields: [parentId], references: [id], onDelete: Restrict)
  messages      Message[]

  @@unique([teacherId, studentId, channelKey])
  @@index([teacherId, lastMessageAt])
  @@index([studentId, lastMessageAt])
  @@index([parentId, lastMessageAt])
  @@map("message_dialogs")
}

model Message {
  id            Int                  @id @default(autoincrement())
  dialogId      Int                  @map("dialog_id")
  senderId      Int                  @map("sender_id")
  senderContext MessageSenderContext @map("sender_context")
  messageText   String?              @map("message_text") @db.Text
  isRead        Boolean              @default(false) @map("is_read")
  readAt        DateTime?            @map("read_at") @db.Timestamptz(3)
  hiddenAt      DateTime?            @map("hidden_at") @db.Timestamptz(3)
  hiddenById    Int?                 @map("hidden_by")
  hiddenReason  String?              @map("hidden_reason") @db.Text
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  dialog        MessageDialog        @relation(fields: [dialogId], references: [id], onDelete: Cascade)
  sender        User                 @relation(fields: [senderId], references: [id], onDelete: Restrict)
  hiddenBy      User?                @relation("MessageHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)
  attachments   MessageAttachment[]
  reports       MessageReport[]

  @@index([dialogId, id])
  @@index([dialogId, isRead, senderId, id])
  @@index([senderId, createdAt])
  @@index([hiddenById])
  @@map("messages")
}

model MessageAttachment {
  id           Int      @id @default(autoincrement())
  messageId    Int      @map("message_id")
  storedPath   String   @map("stored_path") @db.VarChar(500)
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(120)
  fileSize     Int      @map("file_size")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, id])
  @@map("message_attachments")
}

model MessageReport {
  id                Int                 @id @default(autoincrement())
  messageId         Int                 @map("message_id")
  reporterId        Int                 @map("reporter_id")
  reason            MessageReportReason
  comment           String?             @db.Text
  status            MessageReportStatus @default(PENDING)
  handledById       Int?                @map("handled_by")
  resolutionComment String?             @map("resolution_comment") @db.Text
  handledAt         DateTime?           @map("handled_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  message           Message             @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter          User                @relation("MessageReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  handledBy         User?               @relation("MessageReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([messageId, reporterId, createdAt])
  @@index([handledById])
  @@map("message_reports")
}

model StudentProfile {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique @map("user_id")
  firstName         String?  @map("first_name") @db.VarChar(120)
  lastName          String?  @map("last_name") @db.VarChar(120)
  city              String?  @db.VarChar(120)
  timezone          String?  @db.VarChar(80)
  birthYear         Int?     @map("birth_year")
  classLevel        String?  @map("class_level") @db.VarChar(120)
  subjects          String?  @db.Text
  goal              String?  @db.Text
  learningGoals     String?  @map("learning_goals") @db.Text
  levelDescription  String?  @map("level_description") @db.Text
  lessonFormat      String?  @map("lesson_format") @db.VarChar(120)
  parentName        String?  @map("parent_name") @db.VarChar(255)
  parentPhone       String?  @map("parent_phone") @db.VarChar(40)
  parentEmail       String?  @map("parent_email") @db.VarChar(320)
  messenger         String?  @db.VarChar(120)
  contactPreference String?  @map("contact_preference") @db.VarChar(120)
  preferredTime     String?  @map("preferred_time") @db.VarChar(255)
  scheduleComment   String?  @map("schedule_comment") @db.Text
  about             String?  @db.Text
  profileVersion    Int      @default(1) @map("profile_version")
  profileCompletion Int      @default(0) @map("profile_completion")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model TeacherProfile {
  id                         Int                       @id @default(autoincrement())
  userId                     Int                       @unique @map("user_id")
  firstName                  String?                   @map("first_name") @db.VarChar(120)
  lastName                   String?                   @map("last_name") @db.VarChar(120)
  slug                       String?                   @unique @db.VarChar(160)
  city                       String?                   @db.VarChar(120)
  timezone                   String?                   @db.VarChar(80)
  headline                   String?                   @db.VarChar(180)
  experienceYears            Int?                      @map("experience_years")
  about                      String?                   @db.Text
  teachingMethod             String?                   @map("teaching_method") @db.Text
  firstLessonDescription     String?                   @map("first_lesson_description") @db.Text
  studentGets                String?                   @map("student_gets") @db.Text
  price45                    Decimal?                  @map("price_45") @db.Decimal(12, 2)
  price60                    Decimal?                  @map("price_60") @db.Decimal(12, 2)
  price90                    Decimal?                  @map("price_90") @db.Decimal(12, 2)
  trialLessonEnabled         Boolean                   @default(false) @map("trial_lesson_enabled")
  pricingComment             String?                   @map("pricing_comment") @db.Text
  scheduleDescription        String?                   @map("schedule_description") @db.Text
  accessibilityEnabled       Boolean                   @default(false) @map("accessibility_enabled")
  accessibilityFreeLessons   Boolean                   @default(false) @map("accessibility_free_lessons")
  accessibilityDiscount      Boolean                   @default(false) @map("accessibility_discount")
  accessibilityIndividual    Boolean                   @default(false) @map("accessibility_individual")
  accessibilitySlots         Int?                      @map("accessibility_slots")
  accessibilityComment       String?                   @map("accessibility_comment") @db.Text
  introVideoUrl              String?                   @map("intro_video_url") @db.Text
  usesAuthorMaterials        Boolean                   @default(false) @map("uses_author_materials")
  sellsAuthorMaterials       Boolean                   @default(false) @map("sells_author_materials")
  authorMaterialsDescription String?                   @map("author_materials_description") @db.Text
  verificationStatus         TeacherVerificationStatus @default(PENDING) @map("verification_status")
  verificationComment        String?                   @map("verification_comment") @db.VarChar(1000)
  verifiedById               Int?                      @map("verified_by")
  verifiedAt                 DateTime?                 @map("verified_at") @db.Timestamptz(3)
  profileVersion             Int                       @default(2) @map("profile_version")
  profileCompletion          Int                       @default(0) @map("profile_completion")
  isVisible                  Boolean                   @default(false) @map("is_visible")
  rating                     Decimal                   @default(0) @db.Decimal(3, 2)
  reviewsCount               Int                       @default(0) @map("reviews_count")
  createdAt                  DateTime                  @default(now()) @map("created_at")
  updatedAt                  DateTime                  @updatedAt @map("updated_at")
  user                       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy                 User?                     @relation("TeacherProfileVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([verificationStatus, isVisible])
  @@index([verifiedById])
  @@map("teacher_profiles")
}

model SubjectGroup {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(160)
  slug      String    @unique @db.VarChar(160)
  sortOrder Int       @default(100) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  subjects  Subject[]

  @@map("subject_groups")
}

model Subject {
  id                  Int                         @id @default(autoincrement())
  groupId             Int                         @map("group_id")
  name                String                      @db.VarChar(160)
  slug                String                      @unique @db.VarChar(160)
  sortOrder           Int                         @default(100) @map("sort_order")
  isActive            Boolean                     @default(true) @map("is_active")
  group               SubjectGroup                @relation(fields: [groupId], references: [id], onDelete: Restrict)
  preparations        SubjectPreparation[]
  teacherSubjects     TeacherSubject[]
  teacherPreparations TeacherSubjectPreparation[]
  lessons             Lesson[]
  teacherStudents     TeacherStudent[]
  teacherRequests     TeacherStudentRequest[]
  reviews             Review[]
  homework            Homework[]
  materials           LearningMaterial[]
  materialAssignments MaterialAssignment[]

  @@index([groupId, sortOrder])
  @@map("subjects")
}

model PreparationGroup {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(160)
  slug         String        @unique @db.VarChar(160)
  sortOrder    Int           @default(100) @map("sort_order")
  isActive     Boolean       @default(true) @map("is_active")
  preparations Preparation[]

  @@map("preparation_groups")
}

model Preparation {
  id                  Int                         @id @default(autoincrement())
  groupId             Int                         @map("group_id")
  name                String                      @db.VarChar(160)
  slug                String                      @unique @db.VarChar(160)
  sortOrder           Int                         @default(100) @map("sort_order")
  isActive            Boolean                     @default(true) @map("is_active")
  group               PreparationGroup            @relation(fields: [groupId], references: [id], onDelete: Restrict)
  subjects            SubjectPreparation[]
  teacherPreparations TeacherSubjectPreparation[]

  @@index([groupId, sortOrder])
  @@map("preparations")
}

model SubjectPreparation {
  subjectId     Int         @map("subject_id")
  preparationId Int         @map("preparation_id")
  sortOrder     Int         @default(100) @map("sort_order")
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  preparation   Preparation @relation(fields: [preparationId], references: [id], onDelete: Cascade)

  @@id([subjectId, preparationId])
  @@map("subject_preparations")
}

model StudentAgeGroup {
  id           Int               @id @default(autoincrement())
  name         String            @db.VarChar(160)
  slug         String            @unique @db.VarChar(160)
  sortOrder    Int               @default(100) @map("sort_order")
  isActive     Boolean           @default(true) @map("is_active")
  teacherLinks TeacherAgeGroup[]

  @@map("student_age_groups")
}

model TeacherSubject {
  teacherId Int     @map("teacher_id")
  subjectId Int     @map("subject_id")
  teacher   User    @relation("TeacherSubjects", fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([teacherId, subjectId])
  @@map("teacher_subjects")
}

model TeacherSubjectPreparation {
  teacherId     Int         @map("teacher_id")
  subjectId     Int         @map("subject_id")
  preparationId Int         @map("preparation_id")
  teacher       User        @relation("TeacherSubjectPreparations", fields: [teacherId], references: [id], onDelete: Cascade)
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  preparation   Preparation @relation(fields: [preparationId], references: [id], onDelete: Restrict)

  @@id([teacherId, subjectId, preparationId])
  @@map("teacher_subject_preparations")
}

model TeacherAgeGroup {
  teacherId  Int             @map("teacher_id")
  ageGroupId Int             @map("age_group_id")
  teacher    User            @relation("TeacherAgeGroups", fields: [teacherId], references: [id], onDelete: Cascade)
  ageGroup   StudentAgeGroup @relation(fields: [ageGroupId], references: [id], onDelete: Restrict)

  @@id([teacherId, ageGroupId])
  @@map("teacher_age_groups")
}

model TeacherEducation {
  id             Int      @id @default(autoincrement())
  teacherId      Int      @map("teacher_id")
  institution    String   @db.VarChar(255)
  faculty        String?  @db.VarChar(255)
  speciality     String?  @db.VarChar(255)
  qualification  String?  @db.VarChar(255)
  graduationYear Int?     @map("graduation_year")
  description    String?  @db.Text
  isPrimary      Boolean  @default(false) @map("is_primary")
  sortOrder      Int      @default(100) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  teacher        User     @relation("TeacherEducation", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, sortOrder])
  @@map("teacher_education")
}

model TeacherStudent {
  id                  Int                  @id @default(autoincrement())
  teacherId           Int                  @map("teacher_id")
  studentId           Int                  @map("student_id")
  subjectId           Int                  @map("subject_id")
  status              TeacherStudentStatus @default(ACTIVE)
  startedAt           DateTime?            @map("started_at") @db.Timestamptz(3)
  archivedAt          DateTime?            @map("archived_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  teacher             User                 @relation("TeacherStudentTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  student             User                 @relation("TeacherStudentStudent", fields: [studentId], references: [id], onDelete: Restrict)
  subject             Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  review              Review?
  homework            Homework[]
  materialAssignments MaterialAssignment[]

  @@unique([teacherId, studentId, subjectId])
  @@index([teacherId, status])
  @@index([studentId, status])
  @@map("teacher_students")
}

model Review {
  id                   Int               @id @default(autoincrement())
  studentId            Int               @map("student_id")
  teacherId            Int               @map("teacher_id")
  teacherStudentId     Int               @unique @map("teacher_student_id")
  subjectId            Int               @map("subject_id")
  rating               Int
  text                 String            @db.Text
  status               ReviewStatus      @default(PENDING)
  rejectionReason      String?           @map("rejection_reason") @db.Text
  moderatedById        Int?              @map("moderated_by")
