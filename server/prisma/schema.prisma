model Lesson {
  id              Int                   @id @default(autoincrement())
  teacherId       Int                   @map("teacher_id")
  studentId       Int                   @map("student_id")
  subjectId       Int?                  @map("subject_id")
  title           String?               @db.VarChar(255)
  lessonDate      DateTime              @map("lesson_date") @db.Timestamptz(3)
  durationMinutes Int                   @map("duration_minutes")
  status          LessonStatus          @default(SCHEDULED)
  lessonTopic     String?               @map("lesson_topic") @db.VarChar(255)
  lessonNotes     String?               @map("lesson_notes") @db.Text
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  teacher         User                  @relation("LessonTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  student         User                  @relation("LessonStudent", fields: [studentId], references: [id], onDelete: Restrict)
  subject         Subject?              @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  session         LessonSession?
