{
  "name": "gostudy-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "npm run prisma:generate",
    "build": "nest build",
    "test:modules": "npm run build && node scripts/check-module-graph.cjs",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prisma:generate": "node scripts/generate-prisma.cjs",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "documents:import-legacy": "node scripts/import-legacy-teacher-documents.cjs",
    "profile-media:import-legacy": "node scripts/import-legacy-teacher-profile-media.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "16.4.7",
    "helmet": "8.1.0",
    "nodemailer": "9.1.1",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.3",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.5",
    "prisma": "7.10.0",
    "typescript": "5.9.2",
    "vitest": "5.0.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "lodash": "4.18.1",
    "multer": "2.4.0",
    "mysql2": "3.24.4"
  }
}
